def main():
    letters = demo_letters()
    count = int(input("Скільки листів додати? (0 — лише готові): "))
    for number in range(count):
        print(f"Лист {number + 1}:")
        letters.append(Letter(
            input("Індекс: ").strip(),
            input("Місто: ").strip(),
            input("Вулиця: ").strip(),
            input("Будинок: ").strip(),
            input("Квартира: ").strip(),
            input("Прізвище адресата: ").strip(),
        ))
    print("\nУсі листи:")
    print_table(letters)

    correct = []
    returned = []
    for letter in letters:
        if len(letter.index) == 5 and all(c in "0123456789" for c in letter.index):
            correct.append(letter)
        else:
            returned.append(letter)

    correct.sort(key=lambda letter: letter.index)
    print("\nРозсортовані листи за індексом:")
    print_table(correct)
    print("\nПовернути відправнику (неправильний індекс):")
    print_table(returned)

if __name__ == "__main__":
    main()
