# -*- coding: utf-8 -*-
"""
Лабораторна робота №3
Автоматизоване сортування листів на головній пошті.

Запис (структура) листа містить поля:
    - index    : п'ятизначний індекс населеного пункту (рядок)
    - city     : назва міста (рядок)
    - street   : вулиця (рядок)
    - house    : будинок (рядок)
    - flat     : квартира (рядок)
    - surname  : прізвище адресата (рядок)

Сукупність записів об'єднано у масив (список).
Програма забезпечує:
    1) введення інформації;
    2) вивід у вигляді таблиці;
    3) сортування листів за індексом; неправильний індекс -> лист
       повертається відправнику.
"""


# ----------------------- Опис структури (запису) -----------------------
class Letter:
    """Комбінований тип даних — запис про лист."""

    def __init__(self, index, city, street, house, flat, surname):
        self.index = index        # п'ятизначний індекс
        self.city = city          # місто
        self.street = street      # вулиця
        self.house = house        # будинок
        self.flat = flat          # квартира
        self.surname = surname    # прізвище адресата

    def __str__(self):
        return (f"{self.index:>6} | {self.city:<12} | {self.street:<16} | "
                f"{self.house:>4} | {self.flat:>4} | {self.surname:<14}")

    @staticmethod
    def is_valid_index(index):
        """Перевірка, що індекс — це рівно 5 цифр."""
        return index.isdigit() and len(index) == 5


# ----------------------- Допоміжні функції -----------------------
def make_letter(index, city, street, house, flat, surname):
    """Створює запис листа (індекс перевіряється під час сортування)."""
    return Letter(index, city, street, house, flat, surname)


def print_header():
    print("-" * 78)
    print(f"{'Індекс':>6} | {'Місто':<12} | {'Вулиця':<16} | "
          f"{'Буд.':>4} | {'Кв.':>4} | {'Прізвище':<14}")
    print("-" * 78)


def print_table(letters):
    """Вивід масиву записів у вигляді таблиці."""
    print_header()
    for letter in letters:
        print(letter)
    print("-" * 78)
    print(f"Всього листів: {len(letters)}")
    print()


def input_letters():
    """Ручне введення масиву записів з клавіатури."""
    letters = []
    n = int(input("Скільки листів ввести? "))
    for i in range(n):
        print(f"\n--- Лист №{i + 1} ---")
        index = input("Індекс (5 цифр): ").strip()
        city = input("Місто: ").strip()
        street = input("Вулиця: ").strip()
        house = input("Будинок: ").strip()
        flat = input("Квартира: ").strip()
        surname = input("Прізвище адресата: ").strip()
        letters.append(make_letter(index, city, street, house, flat, surname))
    print()
    return letters


